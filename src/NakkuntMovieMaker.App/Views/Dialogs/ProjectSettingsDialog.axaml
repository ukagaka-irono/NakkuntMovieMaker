<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
        x:Class="NakkuntMovieMaker.App.Views.Dialogs.ProjectSettingsDialog"
        x:DataType="vm:ProjectSettingsViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space2}" MinWidth="420">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Classes="field-label" Text="名前" />
      <TextBox Grid.Column="1" Text="{Binding Name}" />

      <TextBlock Grid.Row="1" Classes="field-label" Text="プリセット" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{x:Static vm:ProjectSettingsViewModel.Presets}"
                SelectedItem="{Binding Preset}"
                PlaceholderText="選ぶと幅と高さが入ります" />

      <TextBlock Grid.Row="2" Classes="field-label" Text="幅×高さ" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
        <NumericUpDown Value="{Binding Width}" Minimum="16" Maximum="8192" Increment="2" FormatString="0" Width="120" />
        <TextBlock Text="×" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Height}" Minimum="16" Maximum="8192" Increment="2" FormatString="0" Width="120" />
      </StackPanel>

      <TextBlock Grid.Row="3" Classes="field-label" Text="フレームレート" />
      <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" MinWidth="120" />

      <TextBlock Grid.Row="4" Classes="field-label" Text="サンプルレート" />
      <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:ProjectSettingsViewModel.SampleRates}" SelectedItem="{Binding SampleRate}" MinWidth="120" />
    </Grid>

    <TextBlock Classes="secondary" Text="フレームレートを変えると、アイテムの位置と長さは同じ時刻になるように合わせます" IsVisible="{Binding !IsNew}" TextWrapping="Wrap" MaxWidth="420" />
    <TextBlock Classes="warning" Text="{Binding Error}" IsVisible="{Binding !IsValid}" />

    <StackPanel Classes="dialog-buttons">
      <Button Classes="accent" Content="OK" IsDefault="True" IsEnabled="{Binding IsValid}" Click="OnOk" />
      <Button Content="キャンセル" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
