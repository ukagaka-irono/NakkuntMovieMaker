<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
        x:Class="NakkuntMovieMaker.App.Views.Dialogs.VoiceEnginesDialog"
        x:DataType="vm:VoiceEnginesViewModel"
        Title="音声合成エンジン"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space2}">
    <TextBlock Classes="panel-header" Text="エンジン" />
    <ItemsControl ItemsSource="{Binding Engines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:EngineChoice">
          <Border Classes="panel" Margin="0,0,0,4">
            <StackPanel Spacing="2">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="使えます" Classes="secondary" IsVisible="{Binding Available}" />
                <TextBlock DockPanel.Dock="Right" Text="未導入" Classes="warning" IsVisible="{Binding !Available}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              </DockPanel>
              <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding !Available}" />
              <HyperlinkButton Content="{Binding HelpUrl}" Click="OnOpenLink" Tag="{Binding HelpUrl}" Padding="0"
                               IsVisible="{Binding HelpUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="panel-header" Text="ColorfulTalk の読みの書き方" Margin="0,8,0,0" />
    <SelectableTextBlock Text="{x:Static vm:VoiceEnginesViewModel.KoeGuide}" TextWrapping="Wrap" />
    <HyperlinkButton Content="ColorfulTalk（GitHub）" Click="OnOpenLink" Tag="{x:Static vm:VoiceEnginesViewModel.ColorfulTalkUrl}" Padding="0" />

    <StackPanel Classes="dialog-buttons">
      <Button Classes="accent" Content="閉じる" IsDefault="True" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
