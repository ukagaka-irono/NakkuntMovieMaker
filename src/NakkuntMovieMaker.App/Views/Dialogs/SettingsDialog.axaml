<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
        x:Class="NakkuntMovieMaker.App.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="設定"
        Width="680" Height="620"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource DialogPadding}">
    <StackPanel DockPanel.Dock="Bottom" Classes="dialog-buttons">
      <Button Classes="accent" Content="OK" IsDefault="True" Click="OnOk" />
      <Button Content="キャンセル" IsCancel="True" Click="OnCancel" />
    </StackPanel>
    <TabControl>
      <TabItem Header="ショートカット">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource Space2}" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <Button Content="キーを割り当てる" Command="{Binding CaptureCommand}" />
              <Button Content="割り当てを外す" Command="{Binding ClearCommand}" />
              <Button Content="最初に戻す" Command="{Binding ResetCommand}" />
              <Button Content="すべて最初に戻す" Command="{Binding ResetAllCommand}" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutEntry">
                <Grid ColumnDefinitions="100,*,180">
                  <TextBlock Classes="secondary" Text="{Binding Category}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding GestureText}" FontFamily="monospace" VerticalAlignment="Center"
                             FontWeight="{Binding IsChanged, Converter={x:Static vm:SettingsDialogConverters.BoldWhenTrue}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="全般">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,12,0,0">
          <TextBlock Classes="field-label" Text="自動保存の間隔（分）" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <NumericUpDown Value="{Binding AutosaveMinutes}" Minimum="0" Maximum="60" Increment="1" FormatString="0" Width="120" />
            <TextBlock Classes="secondary" Text="0 にすると自動保存しません" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="field-label" Text="音の出力デバイス" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="secondary" Text="出力デバイスは、次にプロジェクトを開いたときから使います" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Classes="field-label" Text="外部の ffmpeg" />
          <DockPanel Grid.Row="3" Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="指定を外す" Command="{Binding ClearFfmpegCommand}" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="参照…" Command="{Binding BrowseFfmpegCommand}" Margin="4,0,0,0" />
            <TextBox Text="{Binding FfmpegPath}" IsReadOnly="True" />
          </DockPanel>
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="secondary" Text="{Binding FfmpegStatus}" TextWrapping="Wrap" />
        </Grid>
      </TabItem>
      <TabItem Header="描画">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,12,0,0">
          <TextBlock Classes="field-label" Text="描画の方式" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Renderers}" SelectedItem="{Binding Renderer}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Classes="field-label" Text="使う GPU" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GpuDevices}" SelectedItem="{Binding GpuDevice}" IsEnabled="{Binding UsesGpu}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Classes="field-label" Text="GPU のメモリの上限（MB）" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <NumericUpDown Value="{Binding GpuMemoryLimit}" Minimum="0" Maximum="16384" Increment="128" FormatString="0" Width="120"
                           IsEnabled="{Binding UsesGpu}" />
            <TextBlock Classes="secondary" Text="0 にすると自動（GPU のメモリの半分、最大 1024MB）" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="3" Classes="field-label" Text="試験的な機能" />
          <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ExperimentalVulkanVideo}" IsEnabled="{Binding UsesGpu}"
                    Content="動画を Vulkan Video でデコードする（GPU によっては、アプリが止まります）" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="secondary" Text="描画の設定は、次にプロジェクトを開いたときから使います" TextWrapping="Wrap" />
          <TextBlock Grid.Row="5" Classes="field-label" Text="今の描画" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentRenderer}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Row="6" Grid.Column="1" Classes="warning" Text="{Binding RendererProblem}" IsVisible="{Binding HasRendererProblem}" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
