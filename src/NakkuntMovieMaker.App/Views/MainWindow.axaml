<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
        xmlns:views="using:NakkuntMovieMaker.App.Views"
        xmlns:services="using:NakkuntMovieMaker.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="NakkuntMovieMaker.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <!-- メニューの Tag はショートカットのコマンドの ID。表示するキーはショートカットの設定から入れる -->
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規作成(_N)…" Command="{Binding NewProjectCommand}" Tag="file.new" />
        <MenuItem Header="開く(_O)…" Command="{Binding OpenProjectCommand}" Tag="file.open" />
        <MenuItem Header="最近使ったプロジェクト(_R)" ItemsSource="{Binding RecentProjects}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="x:String">
              <Setter Property="Header" Value="{Binding}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <Separator />
        <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" Tag="file.save" />
        <MenuItem Header="名前を付けて保存(_A)…" Command="{Binding SaveAsCommand}" Tag="file.saveAs" />
        <Separator />
        <MenuItem Header="書き出し(_E)…" Command="{Binding ExportCommand}" Tag="file.export" />
        <MenuItem Header="静止画の書き出し…" Command="{Binding ExportStillCommand}" />
        <MenuItem Header="字幕（SRT）の書き出し…" Command="{Binding ExportSubtitlesCommand}" />
        <MenuItem Header="字幕（SRT）の読み込み…" Command="{Binding ImportSubtitlesCommand}" />
        <Separator />
        <MenuItem Header="プロジェクトの設定(_P)…" Command="{Binding ProjectSettingsCommand}" Tag="file.projectSettings" />
        <Separator />
        <MenuItem Header="終了(_X)" Click="OnExit" />
      </MenuItem>
      <MenuItem x:Name="EditMenu" Header="編集(_E)">
        <MenuItem Header="{Binding UndoHeader}" Command="{Binding UndoCommand}" Tag="edit.undo" />
        <MenuItem Header="{Binding RedoHeader}" Command="{Binding RedoCommand}" Tag="edit.redo" />
        <Separator />
        <MenuItem Header="切り取り" Command="{Binding Timeline.CutCommand}" Tag="edit.cut" />
        <MenuItem Header="コピー" Command="{Binding Timeline.CopyCommand}" Tag="edit.copy" />
        <MenuItem Header="貼り付け" Command="{Binding Timeline.PasteCommand}" Tag="edit.paste" />
        <MenuItem Header="複製" Command="{Binding Timeline.DuplicateCommand}" Tag="edit.duplicate" />
        <Separator />
        <MenuItem Header="削除" Command="{Binding Timeline.DeleteCommand}" Tag="edit.delete" />
        <MenuItem Header="削除して詰める" Command="{Binding Timeline.RippleDeleteCommand}" Tag="edit.rippleDelete" />
        <MenuItem Header="分割" Command="{Binding Timeline.SplitCommand}" Tag="edit.split" />
        <Separator />
        <MenuItem Header="グループ化" Command="{Binding Timeline.GroupCommand}" Tag="edit.group" />
        <MenuItem Header="グループ解除" Command="{Binding Timeline.UngroupCommand}" Tag="edit.ungroup" />
        <MenuItem Header="すべて選択" Command="{Binding Timeline.SelectAllCommand}" Tag="edit.selectAll" />
      </MenuItem>
      <MenuItem Header="追加(_I)">
        <MenuItem Header="テキスト" Command="{Binding Timeline.AddTextCommand}" Tag="item.addText" />
        <MenuItem Header="プリセットのテキスト" ItemsSource="{Binding TextPresetList}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="services:TextPreset">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Timeline.AddTextCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <MenuItem Header="図形" ItemsSource="{x:Static vm:TimelineViewModel.ShapeChoices}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ShapeChoice">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Timeline.AddShapeCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="タイムライン(_L)">
        <MenuItem Header="マーカーを置く" Command="{Binding Timeline.AddMarkerCommand}" Tag="timeline.marker" />
        <MenuItem Header="範囲の始まり" Command="{Binding Timeline.SetRangeStartCommand}" Tag="timeline.rangeIn" />
        <MenuItem Header="範囲の終わり" Command="{Binding Timeline.SetRangeEndCommand}" Tag="timeline.rangeOut" />
        <MenuItem Header="範囲を解除" Command="{Binding Timeline.ClearRangeCommand}" Tag="timeline.clearRange" />
        <Separator />
        <MenuItem Header="拡大" Command="{Binding Timeline.ZoomInCommand}" Tag="timeline.zoomIn" />
        <MenuItem Header="縮小" Command="{Binding Timeline.ZoomOutCommand}" Tag="timeline.zoomOut" />
        <MenuItem Header="全体を表示" Command="{Binding Timeline.ZoomToFitCommand}" />
        <MenuItem Header="スナップ" ToggleType="CheckBox" IsChecked="{Binding Timeline.Snap}" Tag="timeline.snap" />
      </MenuItem>
      <MenuItem x:Name="ViewMenu" Header="表示(_V)">
        <MenuItem Header="全画面プレビュー" Command="{Binding Preview.ToggleFullScreenCommand}" Tag="view.fullScreenPreview" />
        <MenuItem Header="グリッド" ToggleType="CheckBox" IsChecked="{Binding Preview.ShowGrid}" />
        <MenuItem Header="セーフエリア" ToggleType="CheckBox" IsChecked="{Binding Preview.ShowSafeArea}" />
        <MenuItem Header="プレビューでプロキシを使う" ToggleType="CheckBox" IsChecked="{Binding Preview.UseProxies}" />
      </MenuItem>
      <MenuItem x:Name="PlayMenu" Header="再生(_P)">
        <MenuItem Header="再生・停止" Command="{Binding Preview.TogglePlayCommand}" Tag="play.toggle" />
        <MenuItem Header="逆方向に再生" Command="{Binding Preview.BackwardCommand}" Tag="play.backward" />
        <MenuItem Header="停止" Command="{Binding Preview.StopCommand}" Tag="play.pause" />
        <MenuItem Header="再生・速める" Command="{Binding Preview.ForwardCommand}" Tag="play.forward" />
        <Separator />
        <MenuItem Header="1 フレーム戻る" Command="{Binding Preview.PreviousFrameCommand}" Tag="play.previousFrame" />
        <MenuItem Header="1 フレーム進む" Command="{Binding Preview.NextFrameCommand}" Tag="play.nextFrame" />
        <MenuItem Header="先頭へ" Command="{Binding Preview.GoToStartCommand}" Tag="play.start" />
        <MenuItem Header="末尾へ" Command="{Binding Preview.GoToEndCommand}" Tag="play.end" />
      </MenuItem>
      <MenuItem x:Name="ToolsMenu" Header="ツール(_T)">
        <MenuItem Header="セリフ入力欄へ" Command="{Binding Dialogue.FocusCommand}" Tag="dialogue.focus" />
        <MenuItem Header="台本の貼り付け…" Command="{Binding Dialogue.PasteScriptCommand}" />
        <MenuItem Header="選んだセリフの声を作り直す" Command="{Binding Dialogue.ResynthesizeCommand}" />
        <Separator />
        <MenuItem Header="録音の開始・停止" Command="{Binding Recording.ToggleRecordCommand}" Tag="record.toggle" />
        <Separator />
        <MenuItem Header="音声合成エンジンと読みの書き方…" Command="{Binding Characters.ShowEngineGuideCommand}" />
        <Separator />
        <MenuItem Header="設定（ショートカット・自動保存）…" Command="{Binding SettingsCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <!-- 今の描画の方式。望んだ方式を使えずに CPU で描いているときは警告の色で、理由をツールチップに出す -->
        <TextBlock DockPanel.Dock="Right" Classes="secondary" Classes.warning="{Binding HasRendererProblem}" Text="{Binding RendererLabel}"
                   ToolTip.Tip="{Binding RendererProblem}" TextWrapping="NoWrap" Margin="12,0,0,0" />
        <TextBlock Classes="secondary" Text="{Binding Status}" />
      </DockPanel>
    </Border>

    <Grid x:Name="Workspace" Margin="4" RowDefinitions="*,4,360" ColumnDefinitions="320,4,*,4,360">
      <Border x:Name="LeftPanel" Classes="panel">
        <TabControl>
          <TabItem Header="素材">
            <views:MediaPoolView DataContext="{Binding MediaPool}" />
          </TabItem>
          <TabItem Header="キャラクター">
            <views:CharactersView DataContext="{Binding Characters}" />
          </TabItem>
          <TabItem Header="録音">
            <views:RecordingView DataContext="{Binding Recording}" />
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
      <Border x:Name="CenterPanel" Grid.Column="2" Classes="panel">
        <views:PreviewView DataContext="{Binding Preview}" />
      </Border>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />
      <Border x:Name="RightPanel" Grid.Column="4" Classes="panel">
        <views:PropertiesView DataContext="{Binding Properties}" />
      </Border>
      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" ResizeDirection="Rows" Background="Transparent" />
      <Border x:Name="BottomPanel" Grid.Row="2" Grid.ColumnSpan="5" Classes="panel">
        <DockPanel>
          <views:DialogueView DockPanel.Dock="Top" DataContext="{Binding Dialogue}" Margin="0,0,0,6" />
          <views:TimelineView DataContext="{Binding Timeline}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
