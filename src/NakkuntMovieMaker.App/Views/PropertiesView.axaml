<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
             xmlns:effects="using:NakkuntMovieMaker.Rendering.Effects"
             x:Class="NakkuntMovieMaker.App.Views.PropertiesView"
             x:DataType="vm:PropertiesViewModel">
  <UserControl.DataTemplates>
    <!-- 入力欄の種類ごとの見た目。左に名前、右に入力欄 -->
    <DataTemplate DataType="vm:AnimatedNumberEditor">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="4">
          <TextBlock Classes="field-label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
          <NumericUpDown Grid.Column="1" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" FormatString="{Binding Format}" />
          <ToggleButton Grid.Column="2" Classes="toolbar keyframe" IsChecked="{Binding HasKey, Mode=OneWay}" Command="{Binding ToggleKeyCommand}" Content="◆"
                        ToolTip.Tip="再生位置にキーフレームを置く・外す" />
        </Grid>
        <ComboBox ItemsSource="{x:Static vm:AnimatedNumberEditor.Easings}" SelectedItem="{Binding Easing}" IsVisible="{Binding HasKey}"
                  HorizontalAlignment="Stretch" Margin="114,0,0,0" ToolTip.Tip="このキーフレームから次までの変化のしかた" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:NumberEditor">
      <Grid ColumnDefinitions="110,*" ColumnSpacing="4">
        <TextBlock Classes="field-label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" FormatString="{Binding Format}" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ColorEditor">
      <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="4">
        <TextBlock Classes="field-label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
        <TextBox Grid.Column="1" Text="{Binding Text}" FontFamily="monospace" ToolTip.Tip="#RRGGBB か、不透明度も入れるなら #RRGGBBAA" />
        <Border Grid.Column="2" Width="28" Height="24" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}">
          <Border.Background>
            <SolidColorBrush Color="{Binding Swatch}" />
          </Border.Background>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:BoolEditor">
      <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="114,0,0,0" />
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceEditor">
      <Grid ColumnDefinitions="110,*" ColumnSpacing="4">
        <TextBlock Classes="field-label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:TextEditor">
      <Grid ColumnDefinitions="110,*" ColumnSpacing="4">
        <TextBlock Classes="field-label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,6,8,0" />
        <TextBox Grid.Column="1" Text="{Binding Text}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" MinHeight="32" MaxHeight="160"
                 PlaceholderText="{Binding Placeholder}" LostFocus="OnTextLostFocus" KeyDown="OnTextKeyDown" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:FileEditor">
      <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="4">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <TextBox Grid.Column="1" Text="{Binding Path}" IsReadOnly="True" />
        <Button Grid.Column="2" Content="参照…" Command="{Binding BrowseCommand}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="panel-header" Text="{Binding Title}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasItem}" />
    <DropDownButton DockPanel.Dock="Bottom" Content="エフェクトを追加" HorizontalAlignment="Stretch" Margin="0,8,0,0" IsVisible="{Binding CanHaveEffects}">
      <DropDownButton.Flyout>
        <MenuFlyout ItemsSource="{x:Static vm:PropertiesViewModel.EffectDefinitions}">
          <MenuFlyout.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="effects:EffectDefinition">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).AddEffectCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuFlyout.ItemContainerTheme>
        </MenuFlyout>
      </DropDownButton.Flyout>
    </DropDownButton>
    <Grid>
      <TextBlock Classes="empty-hint" Text="{Binding Hint}" IsVisible="{Binding !HasItem}" />
      <ScrollViewer IsVisible="{Binding HasItem}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PropertyGroup">
              <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                <Expander.Header>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsEffect}">
                      <Button Classes="toolbar" Content="有効" ToolTip.Tip="有効・無効を切り替える"
                              Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).ToggleEffectCommand}" CommandParameter="{Binding Effect}" />
                      <Button Classes="toolbar" Content="↑" ToolTip.Tip="上へ（先にかける）"
                              Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).MoveEffectUpCommand}" CommandParameter="{Binding Effect}" />
                      <Button Classes="toolbar" Content="↓" ToolTip.Tip="下へ（後にかける）"
                              Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).MoveEffectDownCommand}" CommandParameter="{Binding Effect}" />
                      <Button Classes="toolbar" Content="×" ToolTip.Tip="エフェクトを外す"
                              Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).RemoveEffectCommand}" CommandParameter="{Binding Effect}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Editors}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
