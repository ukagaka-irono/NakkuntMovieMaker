<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NakkuntMovieMaker.App.ViewModels"
             x:Class="NakkuntMovieMaker.App.Views.MediaPoolView"
             x:DataType="vm:MediaPoolViewModel"
             DragDrop.AllowDrop="True">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
        <Button Classes="toolbar" Content="追加" Command="{Binding ImportCommand}" ToolTip.Tip="動画・画像・音声のファイルを素材に加えます（ファイルをここにドロップしても加えられます）" />
        <Button Classes="toolbar" Content="リンク切れを探す" Command="{Binding SearchMissingCommand}" IsVisible="{Binding HasMissing}"
                ToolTip.Tip="見つからない素材を、選んだフォルダの中から同じ名前で探します" />
      </StackPanel>
    </DockPanel>

    <Grid>
      <TextBlock Classes="empty-hint" Text="動画・画像・音声のファイルを&#x0a;ここにドロップ" IsVisible="{Binding IsEmpty}" />
      <ListBox x:Name="AssetList" ItemsSource="{Binding Assets}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="再生位置に置く" Command="{Binding AddToTimelineCommand}" />
            <MenuItem Header="場所を指定し直す…" Command="{Binding RelinkCommand}" />
            <MenuItem Header="入力の色空間" ItemsSource="{Binding InputColorSpaces}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ColorSpaceChoice">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="Command" Value="{Binding $parent[ContextMenu].((vm:MediaPoolViewModel)DataContext).SetInputColorSpaceCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <MenuItem Header="プロキシを作る" Command="{Binding CreateProxyCommand}" />
            <MenuItem Header="プロキシを削除する" Command="{Binding DeleteProxyCommand}" />
            <Separator />
            <MenuItem Header="一覧から外す" Command="{Binding RemoveCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AssetEntry">
            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="{Binding FullPath}">
              <Border Width="96" Height="54" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="2" ClipToBounds="True">
                <Panel>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                  <TextBlock Classes="secondary" Text="♪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsAudio}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                  <TextBlock Classes="secondary" Text="{Binding KindLabel}" />
                  <TextBlock Classes="secondary" Text="{Binding Details}" />
                </StackPanel>
                <TextBlock Classes="secondary" Text="{Binding ColorSpaceLabel}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasColorSpace}" />
                <TextBlock Classes="secondary" Text="{Binding ProxyStatus}" IsVisible="{Binding HasProxyStatus}" />
                <TextBlock Classes="warning" Text="ファイルが見つかりません" FontSize="{StaticResource SmallFontSize}" IsVisible="{Binding IsMissing}" />
                <TextBlock Classes="warning" Text="{Binding ColorError}" FontSize="{StaticResource SmallFontSize}" IsVisible="{Binding HasColorError}" />
                <TextBlock Classes="warning" Text="{Binding ProxyError}" FontSize="{StaticResource SmallFontSize}" IsVisible="{Binding HasProxyError}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
