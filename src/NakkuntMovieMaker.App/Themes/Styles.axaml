<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- パネル・見出し・ダイアログのボタンの書き方。画面はここのクラスを使い、個別に色や余白を書かない -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
  </Style>

  <Style Selector="TextBlock.panel-header">
    <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
  </Style>

  <Style Selector="TextBlock.empty-hint">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- ダイアログの下のボタンの並び（右寄せ） -->
  <Style Selector="StackPanel.dialog-buttons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Spacing" Value="{StaticResource Space2}" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>

  <Style Selector="StackPanel.dialog-buttons > Button">
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
</Styles>
