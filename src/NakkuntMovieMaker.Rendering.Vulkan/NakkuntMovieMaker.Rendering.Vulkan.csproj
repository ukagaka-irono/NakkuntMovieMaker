<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vulkan での GPU 描画（M2）。macOS は MoltenVK を使う -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Vulkan" />
    <PackageReference Include="Vortice.VulkanMemoryAllocator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NakkuntMovieMaker.Rendering/NakkuntMovieMaker.Rendering.csproj" />
    <ProjectReference Include="../NakkuntMovieMaker.Rendering.Skia/NakkuntMovieMaker.Rendering.Skia.csproj" />
  </ItemGroup>

  <!-- シェーダー（Shaders/*.slang）は Shaders.targets で SPIR-V にして埋め込む -->
  <ItemGroup>
    <NmmShader Include="Shaders/*.slang" />
    <None Include="Shaders/**/*.slang" />
  </ItemGroup>

  <Import Project="Shaders.targets" />
</Project>
