<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NakkuntMovieMaker.Rendering.Vulkan/NakkuntMovieMaker.Rendering.Vulkan.csproj" />
    <ProjectReference Include="../../src/NakkuntMovieMaker.Engine/NakkuntMovieMaker.Engine.csproj" />
    <ProjectReference Include="../NakkuntMovieMaker.Rendering.TestSupport/NakkuntMovieMaker.Rendering.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NakkuntMovieMaker.Rendering.TestSupport" />
  </ItemGroup>

  <!--
    GPU のテストは、テストのクラスを並べて回さない（CI の Linux の lavapipe と検証レイヤーで、
    いくつものデバイスを同時に使うと、ときどきプロセスごと落ちたため）
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Media のテスト用の動画を使い回す（Vulkan Video のデコード） -->
  <ItemGroup>
    <None Include="../NakkuntMovieMaker.Media.Tests/Fixtures/frames-2997.mp4;../NakkuntMovieMaker.Media.Tests/Fixtures/hevc-main10-320x240.mp4"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- テスト用のシェーダー（共通の関数は本体の Shaders/Library を使う） -->
  <ItemGroup>
    <NmmShader Include="Shaders/*.slang" />
    <None Include="Shaders/*.slang" />
  </ItemGroup>

  <Import Project="../../src/NakkuntMovieMaker.Rendering.Vulkan/Shaders.targets" />
</Project>
